{
  "name": "playwright-hybrid-testing-framework",
  "version": "1.0.0",
  "description": "Production-grade E2E &amp; REST API test automation framework using Playwright &amp; TypeScript. Featuring API authentication bypass (storageState), Page Object Model (POM), and dynamic test data generation with Faker.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-results",
    "slack:notify": "node --env-file=.env scripts/slack-notifier.mjs",
    "test:full": "npm run test && npm run allure:generate && npm run slack:notify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.5.4"
  }
}
